# =============================================================================
# Doctor Appointment API - environment variables
#
# LOCAL:   copy this file to server/.env and fill in the values.
# RAILWAY: backend service -> Variables -> Raw Editor, paste this file, then:
#   - set NODE_ENV=production
#   - DELETE PORT (Railway sets it) and all DB_HOST..DB_SSL lines
#   - set DATABASE_URL=${{Postgres.DATABASE_URL}}
#   - set ALLOWED_ORIGINS and APP_URL to the frontend Railway URL
#   - use a fresh JWT_SECRET
# Frontend service needs only: VITE_API_URL=https://<backend-url> (no trailing slash)
# =============================================================================

# development | production   (Railway: production)
NODE_ENV=development
# Local only - remove on Railway
PORT=5000

# Comma separated list of origins allowed to call the API
# Railway: https://<frontend>.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173
# Where the React app runs; used in e-mailed links (password reset). Defaults to the first allowed origin.
# Railway: https://<frontend>.up.railway.app
APP_URL=http://localhost:5173

# --- PostgreSQL ---------------------------------------------------------------
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}  (when set, DB_* below are ignored)
# To reach the Railway DB from your PC use its PUBLIC URL (Postgres -> Connect -> Public Network) and DB_SSL=true
DATABASE_URL=
# Local only - remove on Railway
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=doctor_appointments
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_LOGGING=false

# --- Auth -----------------------------------------------------------------------
# A long random string, never committed. Use a different one in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Times inside notification texts are written in this zone
DISPLAY_TIMEZONE=Asia/Kolkata

# Set to false to run the API without the reminder / auto-reschedule job
# (keep Railway "Serverless" OFF or the job won't run)
SCHEDULER_ENABLED=true

# Uploads folder. Empty = server/uploads (wiped on every Railway redeploy).
# Railway: attach a Volume (e.g. mounted at /data) and set UPLOAD_DIR=/data/uploads
UPLOAD_DIR=

# First admin account (created by `npm run db:init`)
# Change the password before deploying!
ADMIN_EMAIL=amrithamrith2753@gmail.com
ADMIN_PASSWORD=Admin@1234

# --- Optional SMTP --------------------------------------------------------------
# Without it, notifications are in-app only (e-mails are logged in development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
