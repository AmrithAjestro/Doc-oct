NODE_ENV=development
PORT=5000
# Comma separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=doctor_appointments
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_LOGGING=false

# JSON Web Token secret — a long random string, never committed.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Times inside notification texts are written in this zone
DISPLAY_TIMEZONE=Asia/Kolkata

# Set to false to run the API without the reminder / auto-reschedule job
SCHEDULER_ENABLED=true

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL=admin@docbook.local
ADMIN_PASSWORD=Admin@1234

# Optional SMTP. Without it, notifications are in-app only (e-mails are logged in development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
