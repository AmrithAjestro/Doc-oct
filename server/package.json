{
  "name": "doctor-appointment-server",
  "version": "1.0.0",
  "description": "Doctor Appointment System API (Express, Sequelize, PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/scripts/init-db.js && node src/scripts/seed.js",
    "db:seed": "node src/scripts/seed.js",
    "db:seed:demo": "node src/scripts/seed.js --demo",
    "db:setup": "node src/scripts/init-db.js && node src/scripts/seed.js --demo",
    "db:reset": "node src/scripts/init-db.js --reset && node src/scripts/seed.js --demo",
    "test": "node --test \"src/tests/*.test.js\"",
    "test:e2e": "node src/scripts/e2e.test.js",
    "test:e2e:clinic": "node src/scripts/e2e.clinic.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ignore": [
      "uploads"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
