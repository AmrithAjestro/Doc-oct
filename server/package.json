{
  "name": "doctor-appointment-server",
  "version": "1.0.0",
  "description": "Doctor Appointment System API (Express, Sequelize, PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "node src/scripts/seed.js",
    "db:seed:demo": "node src/scripts/seed.js --demo",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed:demo",
    "db:reset": "npm run db:migrate:undo && npm run db:migrate && npm run db:seed:demo",
    "test:e2e": "node src/scripts/e2e.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ignore": [
      "uploads"
    ]
  }
}
